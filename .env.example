# Copy to .env and fill in. Everything here is a secret or belongs to you; nothing in this
# file is needed by the app itself, only by the Telegram front end.

# From @BotFather. The bot does not start without it, and says so rather than idling.
TELEGRAM_BOT_TOKEN=

# The secret the app and the bot share (R26): the bot sends it to prove it is the bot, and the app
# uses it to decide which account a chat is. Both services read it, so it must be set once here and
# nowhere else. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_BOT_SECRET=

# Who may talk to it: your Telegram user id, comma-separated for more than one. An empty
# value means every chat that finds the bot can log into the food log, so set it. Your id
# is what @userinfobot replies with.
#
# With chat binding (R26) this is an outer gate rather than the protection: an unbound chat is
# refused by the app whatever this says. Leave it empty if you want other people to be able to
# register and bind their own chats.
TELEGRAM_ALLOWED_USERS=

# Where the admin is told that someone is waiting for approval (Part 14): your own Telegram chat id, the same number as
# your entry in TELEGRAM_ALLOWED_USERS. Send the bot a message first, or Telegram will not let it write to you. It is not
# a secret, but it stays in .env with the rest. Empty means nobody is told: registrations still wait, and
# `scripts/users.sh list` shows them.
TELEGRAM_ADMIN_CHAT=

# A free key from https://api.data.gov/signup/ for looking up foods that are not in the list (D20).
# The app uses it, not the bot. Leave it empty and lookup simply reports that it is not configured.
USDA_API_KEY=
